# ====================================================================
# OmniBot — VARIÁVEIS DE AMBIENTE
# ====================================================================

# --- Inteligência Artificial Instagram (9Router / OpenAI) ---
OPENAI_API_KEY=your_real_openai_api_key
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_MODEL=9router
OPENAI_MODEL_FAST=9router
OPENAI_MONTHLY_BUDGET_USD=50

# --- Inteligência Artificial WhatsApp (Dedicada) ---
# Chave, modelos e base URL dedicados para reescrita e testes do WhatsApp
OPENAI_API_KEY_WHATSAPP=your_whatsapp_openai_api_key
OPENAI_BASE_URL_WHATSAPP=http://localhost:20128/v1
OPENAI_MODEL_WHATSAPP=9router
OPENAI_MODEL_FAST_WHATSAPP=9router

# --- Browser Instagram (Playwright CDP) ---
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile

# --- Meta API & Webhooks ---
INSTAGRAM_APP_SECRET=your_app_secret_from_meta
INSTAGRAM_PAGE_ACCESS_TOKEN=your_long_lived_page_access_token
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=any_random_string_you_invented
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# --- Evolution API (WhatsApp) ---
# URL base da Evolution API
EVOLUTION_API_URL=http://localhost:8080
# Chave global da Evolution API
EVOLUTION_API_KEY=sua_evolution_api_key_aqui
# Nome da instância dedicada do WhatsApp para o OmniBot
EVOLUTION_INSTANCE_NAME=omnibot_wa

# --- Relatórios e Notificações ---
OPERATOR_WHATSAPP_NUMBER=5511999999999

# --- Banco de Dados ---
DATABASE_URL=data/sqlite.db

# --- Limites Operacionais ---
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Sao_Paulo
OPERATING_DAYS=1,2,3,4,5
PROSPECTION_ONLY=false

# --- Ambiente ---
DRY_RUN=false
